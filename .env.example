NEXT_PUBLIC_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_HAPPYVIEW_CLIENT_KEY=
NEXT_PUBLIC_HAPPYVIEW_URL=

# HappyView confidential API client for server renders and route handlers
# (server-only; never NEXT_PUBLIC_). Gives the server its own rate-limit
# bucket instead of sharing the browsers' public key. Unset = public key.
HAPPYVIEW_SERVER_CLIENT_KEY=
HAPPYVIEW_SERVER_CLIENT_SECRET=

# Analytics — client toggle (set 'true' to enable in-browser collection)
NEXT_PUBLIC_ANALYTICS_ENABLED=

# Analytics ingest collector (server-only, /api/analytics/collect)
ANALYTICS_ENABLED=
# Secret key for the salted daily visitor hash. Generate a long random value.
ANALYTICS_SALT_SECRET=
# ClickHouse (insert-only user) — public TLS ingest endpoint
CLICKHOUSE_URL=
CLICKHOUSE_INSERT_USER=
CLICKHOUSE_INSERT_PASSWORD=
CLICKHOUSE_DATABASE=cartridge_analytics